# LiveKit agent — all-AWS streaming voice pipeline (VAD + Transcribe + Bedrock + Polly).
# Python 3.12: livekit-plugins-aws STT (Transcribe streaming) requires 3.12+.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN pip install --no-cache-dir \
    livekit-agents livekit-plugins-aws livekit-plugins-silero boto3 \
    aws_sdk_transcribe_streaming

COPY worker/agent_lk.py .
# Pre-download the Silero VAD weights so the first call doesn't pay for it.
RUN python -c "from livekit.plugins import silero; silero.VAD.load()" || true
CMD ["python", "-u", "agent_lk.py", "start"]
